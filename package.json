{
  "name": "cloudmeet",
  "version": "1.0.0",
  "description": "A self-hosted Cloudflare meeting scheduler with Google Calendar and Outlook Calendar integration.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "npm run build && wrangler pages dev .svelte-kit/cloudflare",
    "dev:watch": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "db:init": "wrangler d1 execute cloudmeet --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute cloudmeet --file=./schema.sql",
    "deploy": "npm run build && wrangler pages deploy .svelte-kit/cloudflare",
    "prebuild": "node scripts/prebuild.js"
  },
  "keywords": [
    "calendly",
    "meeting-scheduler",
    "cloudflare",
    "svelte",
    "sveltekit",
    "google-calendar"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jascenn/CloudMeet"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250927.0",
    "@sveltejs/adapter-cloudflare": "^7.2.3",
    "@sveltejs/kit": "^2.43.5",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "svelte": "^5.57.3",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "wrangler": "^4.154.0"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.18"
  }
}
